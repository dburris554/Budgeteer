# Authentication Configuration
# Update auth_config.yaml with your credentials, then this file is not needed for basic auth

# Google Sheets Configuration (Optional - only needed for authenticated GSheets persistence)
# Follow this guide to set up OAuth: https://docs.streamlit.io/develop/tutorials/databases/cloud-sql
# Or use Service Account: https://github.com/streamlit/gsheets-connection

[connections.gsheets]
# For OAuth (User's Google Account):
# After setting up OAuth credentials in Google Cloud Console, Streamlit will handle the OAuth flow
# No secrets needed - authentication happens at runtime

# For Service Account (optional, more complex):
# spreadsheet = "YOUR_SPREADSHEET_ID_OR_URL"
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "your-private-key-id"
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "service-account@your-project.iam.gserviceaccount.com"
# client_id = "your-client-id"
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."
